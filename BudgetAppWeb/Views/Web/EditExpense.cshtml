@model BudgetAppWeb.Models.Expense

@{
    ViewBag.Title = "Edit Expense";
}

@section title{
    <a href="/Budget/@Model.BudgetId">Edit expense</a>
}
@section subtitle{
    <span class="appbar__sub">@ViewBag.BudgetName</span>
}


@section nav{
    <a class="btn btn--text" href="/Budget/@Model.BudgetId">Cancel</a>
}

<section class="card amount-card">
    <label class="field__label" for="amount">Amount</label>
    <input class="field__input" id="amount" type="number" autofocus inputmode="decimal" step="0.01"
           placeholder="0" data-bind="value: amount, valueUpdate: 'input'" />
</section>

<div class="field mt-l">
    <label class="field__label" for="description">Description</label>
    <input class="field__input" id="description" type="text" data-bind="value: description" />
</div>

<div class="field">
    <label class="field__label" for="date">Date</label>
    <input class="field__input" id="date" type="date" data-bind="value: date" />
</div>

<div class="form-actions">
    <button class="btn btn--block" data-bind="click: save, disable: saving">Save changes</button>
</div>

@section bottomnav{
    <nav class="bottomnav">
        <div class="bottomnav__inner">
            <a class="bottomnav__item" href="/Budget/@Model.BudgetId">
                <span class="bottomnav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11z"/></svg></span>
                Week
            </a>
            <a class="bottomnav__item" href="/Budget/@Model.BudgetId/Month">
                <span class="bottomnav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 3h-1V1h-2v2H7V1H5v2H4a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 18H4V8h16v13zM6 10h5v5H6z"/></svg></span>
                Month
            </a>
            <a class="bottomnav__item bottomnav__item--accent" href="/Budget/@Model.BudgetId/Add">
                <span class="bottomnav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"/></svg></span>
                Add
            </a>
        </div>
    </nav>
}

@section scripts{
    <script type="text/javascript">
        function EditExpenseViewModel() {
            var self = this;
            var budgetId = "@Model.BudgetId";

            this.date = ko.observable("@Model.Date.ToString("yyyy-MM-dd")");
            this.description = ko.observable(@Html.Raw(Json.Encode(Model.Description)));
            this.amount = ko.observable(@Model.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture));
            this.saving = ko.observable(false);

            this.save = function () {
                if (!self.description()) { alert('Enter a description'); return; }
                if (self.amount() === '' || isNaN(parseFloat(self.amount()))) {
                    alert('Enter an amount');
                    return;
                }

                self.saving(true);
                $.ajax("/api/Expense/@Model.Id", {
                    data: ko.toJSON({
                        id: @Model.Id,
                        date: self.date(),
                        description: self.description(),
                        amount: parseFloat(self.amount()),
                        budgetId: budgetId
                    }),
                    type: "put",
                    contentType: "application/json",
                    success: function () { window.location.href = '/Budget/' + budgetId; },
                    error: function () {
                        self.saving(false);
                        alert('Could not save that change. Please try again.');
                    }
                });
            };
        }

        ko.applyBindings(new EditExpenseViewModel());
    </script>
}
