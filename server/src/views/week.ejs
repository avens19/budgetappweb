<%- include('partials/head') %>
            <div class="appbar__titles">
                <h1 class="appbar__title"><a href="/Budget/<%= budget.UniqueId %>"><%= budget.Name || "Weekly Budget" %></a></h1>
            </div>
            <div class="appbar__actions"><button class="btn btn--text" data-bind="click: goToday, visible: !isCurrentWeek()"><%= t('action.today') %></button>
    <a class="btn btn--icon" href="/Budget/<%= budget.UniqueId %>/Edit" title="Edit budget" aria-label="Edit budget"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zM15 9h2V7h4V5h-4V3h-2v6z"/></svg></a></div>
<%- include('partials/afterbar') %>
<%# Stepping a week at a time is fine for last week and useless for last
   March, so the heading opens a date picker and jumps to whichever week
   contains the date chosen. %>
<div class="period">
    <button class="btn btn--icon" data-bind="click: weekBack" aria-label="<%= t('week.previous') %>">&#8249;</button>
    <button type="button" class="period__label" data-bind="click: pickDate" title="<%= t('week.jump') %>">
        <span data-bind="text: periodLabel"></span>
        <span class="period__sub" data-bind="text: periodSub, visible: periodSub"></span>
    </button>
    <input class="period__input" type="date" id="weekPicker" tabindex="-1" aria-hidden="true"
           data-bind="value: pickerValue, event: { change: onDatePicked }" />
    <button class="btn btn--icon" data-bind="click: weekAhead" aria-label="<%= t('week.next') %>">&#8250;</button>
</div>

<section class="card card--hero" data-bind="css: { 'card--over': !isUnder() }">
    <p class="hero__label" data-bind="text: isUnder() ? t('js.leftToSpend') : t('js.overBudget')"></p>
    <p class="hero__amount" data-bind="text: money(remaining())"></p>
    <div class="progress">
        <div class="progress__fill" data-bind="style: { width: spentPercent() + '%' }"></div>
    </div>
    <div class="hero__foot">
        <span data-bind="text: money(total()) + ' of ' + money(limit())"></span>
        <%# Only offered when there is something to carry: the app hides it once
           the week is spent, and an "carry $0.00 forward" button is noise. %>
        <button class="btn btn--text" data-bind="click: carryBalance, visible: canCarry">
            <%= t('week.carry') %>
        </button>
    </div>
</section>

<div data-bind="visible: expenses().length > 0, foreach: days">
    <div class="section-head">
        <span data-bind="text: label"></span>
        <span class="money" data-bind="text: money(total)"></span>
    </div>
    <!-- ko foreach: expenses -->
    <a class="row" data-bind="attr: { href: '/Budget/' + $root.budgetId + '/Edit/' + id() }">
        <span class="row__dot" data-bind="style: { background: $root.categoryColor(categoryId()) }"></span>
        <span class="row__main">
            <span class="row__title" data-bind="text: description"></span>
            <span class="row__sub" data-bind="text: $root.categoryName(categoryId())"></span>
        </span>
        <span class="row__amount" data-bind="text: money(amount())"></span>
    </a>
    <!-- /ko -->
</div>

<div class="empty" data-bind="visible: expenses().length === 0">
    <p class="empty__title"><%= t('week.empty.title') %></p>
    <p class="empty__body"><%= t('week.empty.body') %></p>
</div>
<%- include('partials/bottomnav', { budget: budget, active: 'week' }) %>
<%- include('partials/scripts') %>
<script type="text/javascript">
        function Expense(data) {
            var date = new Date(data.Date);
            date = new Date(date.getTime() + (date.getTimezoneOffset() * 60000));
            this.id = ko.observable(data.Id);
            this.date = ko.observable(date);
            this.description = ko.observable(data.Description);
            this.amount = ko.observable(data.Amount);
            this.categoryId = ko.observable(data.CategoryId);
        }

        function BudgetViewModel() {
            var self = this;

            this.budgetId = "<%= budget.UniqueId %>";
            this.expenses = ko.observableArray();

            // Categories change far less often than expenses, so they are
            // fetched once rather than on every week step.
            this.categories = ko.observable(categoryIndex([]));
            loadCategories(this.budgetId, function (rows) {
                self.categories(categoryIndex(rows));
            });
            this.categoryColor = function (id) { return self.categories().colorFor(id); };
            this.categoryName = function (id) { return self.categories().nameFor(id); };

            this.total = ko.computed(function () {
                var total = 0;
                for (var i = 0; i < self.expenses().length; i++) {
                    total += self.expenses()[i].amount();
                }
                return total;
            });

            this.limit = ko.observable(<%= budget.Amount %>);
            this.isUnder = ko.computed(function () { return self.total() <= self.limit(); });
            this.remaining = ko.computed(function () { return Math.abs(self.limit() - self.total()); });

            this.spentPercent = ko.computed(function () {
                if (self.limit() <= 0) { return 0; }
                return Math.max(0, Math.min(100, (self.total() / self.limit()) * 100));
            });

            var today = new Date();
            var weekStart = today;
            var startDay = <%= budget.StartDay %>;

            while (weekStart.getDay() != startDay) {
                weekStart = weekStart.addDays(-1);
            }

            this.weekStart = ko.observable(weekStart);
            this.weekEnd = ko.observable(weekStart.addDays(6));

            this.isCurrentWeek = ko.computed(function () {
                var now = new Date(); now.setHours(0, 0, 0, 0);
                var start = new Date(self.weekStart()); start.setHours(0, 0, 0, 0);
                var end = new Date(self.weekEnd()); end.setHours(0, 0, 0, 0);
                return now >= start && now <= end;
            });

            this.pickerValue = ko.observable(toDateInput(weekStart));

            this.periodLabel = ko.computed(function () {
                return shortDate(self.weekStart()) + ' – ' + shortDate(self.weekEnd());
            });

            // "This week" only while today actually falls inside the range.
            this.periodSub = ko.computed(function () {
                var now = new Date();
                now.setHours(0, 0, 0, 0);
                var start = new Date(self.weekStart()); start.setHours(0, 0, 0, 0);
                var end = new Date(self.weekEnd()); end.setHours(0, 0, 0, 0);
                if (now < start || now > end) { return ''; }
                var daysLeft = Math.round((end - now) / 86400000);
                if (daysLeft === 0) { return t('js.weekLastDay'); }
                if (daysLeft === 1) { return t('js.weekOneDayLeft'); }
                return t('js.weekDaysLeft').replace('{days}', daysLeft);
            });

            // Expenses grouped under a heading per day, as on the phone.
            this.days = ko.computed(function () {
                var groups = [];
                var byKey = {};
                var list = self.expenses();

                for (var i = 0; i < list.length; i++) {
                    var e = list[i];
                    var key = e.date().toDateString();
                    if (!byKey[key]) {
                        byKey[key] = {
                            label: e.date().toLocaleDateString(undefined,
                                { weekday: 'long', month: 'short', day: 'numeric' }),
                            total: 0,
                            expenses: []
                        };
                        groups.push(byKey[key]);
                    }
                    byKey[key].total += e.amount();
                    byKey[key].expenses.push(e);
                }
                return groups;
            });

            function loadData() {
                api.get("/api/Budget/<%= budget.UniqueId %>/Week/" + self.weekStart().getTime())
                    .then(function (allData) {
                        self.expenses(allData.map(function (item) { return new Expense(item); }));
                    });
            }

            loadData();

            // showPicker opens the native calendar straight away where it is
            // supported; focusing the input is the fallback everywhere else.
            this.pickDate = function () {
                var input = document.getElementById('weekPicker');
                self.pickerValue(toDateInput(self.weekStart()));
                if (typeof input.showPicker === 'function') {
                    try { input.showPicker(); return; } catch (e) { /* fall through */ }
                }
                input.focus();
                input.click();
            };

            this.onDatePicked = function () {
                var input = document.getElementById('weekPicker');
                if (!input.value) { return; }
                var parts = input.value.split('-');
                var chosen = new Date(+parts[0], +parts[1] - 1, +parts[2]);
                while (chosen.getDay() != startDay) { chosen = chosen.addDays(-1); }
                self.weekStart(chosen);
                self.weekEnd(chosen.addDays(6));
                loadData();
            };

            this.goToday = function () {
                var start = new Date();
                while (start.getDay() != startDay) { start = start.addDays(-1); }
                self.weekStart(start);
                self.weekEnd(start.addDays(6));
                loadData();
            };

            this.weekBack = function () {
                self.weekStart(self.weekStart().addDays(-7));
                self.weekEnd(self.weekEnd().addDays(-7));
                loadData();
            };

            this.weekAhead = function () {
                self.weekStart(self.weekStart().addDays(7));
                self.weekEnd(self.weekEnd().addDays(7));
                loadData();
            };

            this.canCarry = ko.computed(function () {
                return self.isUnder() && self.remaining() >= 0.01;
            });

            // Carrying is a negative expense on the first day of the following
            // week, which is how the app does it: an expense of -X raises next
            // week's available spend by X without touching the budget amount.
            // IsSystem marks it as generated rather than something typed.
            this.carryBalance = function () {
                var rounded = Math.round(self.remaining() * 100) / 100;
                if (!confirm(t('js.confirmCarry').replace('{amount}', money(rounded)))) { return; }

                var next = self.weekStart().addDays(7);
                api.send('POST', '/api/Expense', {
                    date: toDateInput(next),
                    description: t('js.carriedBalance'),
                    amount: -rounded,
                    budgetId: self.budgetId,
                    isSystem: true
                })
                    .then(function () { loadData(); })
                    .catch(function () { alert('Could not carry that balance. Please try again.'); });
            };
        }

        ko.applyBindings(new BudgetViewModel());

        var first = <%= first ? "true" : "false" %>;
        if (first) {
            alert("Add this page to your home screen to use it like an app.");
        }
    </script>
<%- include('partials/foot') %>
