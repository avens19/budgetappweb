<%- include('partials/head') %>
            <div class="appbar__titles">
                <h1 class="appbar__title"><a href="/">Weekly Budget</a></h1>
            </div>
            <div class="appbar__actions"></div>
<%- include('partials/afterbar') %>
<%#
    The landing page is where someone decides whether this app is for them, so
    it leads with how it is meant to be used — the same explanation the Android
    app now gives on first run.
%>
<section class="card mt-l">
    <h2 class="empty__title" style="margin-bottom:10px"><%= t('tutorial.1.title') %></h2>
    <p class="muted" style="margin:0 0 12px"><%= t('landing.lead1') %></p>
    <p class="muted" style="margin:0"><%= t('landing.lead2') %></p>
    <p style="margin:12px 0 0"><a href="/HowItWorks"><%= t('howItWorks.title') %></a> &middot; <a href="/Apps"><%= t('apps.title') %></a> &middot; <a href="/About"><%= t('about.title') %></a> &middot; <a href="/privacy"><%= t('privacy.title') %></a></p>
</section>

<h2 class="section-head" style="margin-top:28px"><%= t('landing.create') %></h2>

<div class="field">
    <label class="field__label" for="name"><%= t('budget.name') %></label>
    <input class="field__input" id="name" type="text" data-bind="value: name" placeholder="<%= t('budget.name.example') %>" />
</div>

<div class="field">
    <label class="field__label" for="amount"><%= t('budget.amount') %></label>
    <input class="field__input" id="amount" type="number" inputmode="decimal" step="0.01"
           data-bind="value: amount" placeholder="0.00" />
    <%# Directly under the field, because "how much a week?" is the question
       this page asks that people cannot answer. %>
    <p class="field__hint" style="margin-top:6px"><a href="/WeeklyNumber"><%= t('planner.open') %></a></p>
</div>

<div class="field">
    <label class="field__label" for="startDay"><%= t('budget.startDay') %></label>
    <select class="field__input" id="startDay" data-bind="options: dates, value: startDay"></select>
</div>

<section class="card">
    <div class="id-card">
        <div>
            <div class="field__label" style="margin-bottom:4px"><%= t('budget.id') %></div>
            <div class="id-card__value" data-bind="text: uniqueId"></div>
            <p class="field__hint" style="margin-left:0">
                <%= t('budget.id.hintAndroid') %>
            </p>
        </div>
    </div>
</section>

<div class="form-actions">
    <button class="btn btn--block" data-bind="click: newBudget, disable: saving"><%= t('budget.create') %></button>
</div>
<%- include('partials/beforenav') %>
<%- include('partials/scripts') %>
<script type="text/javascript">
        function NewBudgetViewModel() {
            var self = this;

            this.name = ko.observable('');
            this.startDay = ko.observable("<%= budget.StartDayOfWeek %>");
            this.dates = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            // A figure accepted in the helper comes back as ?amount=. Read
            // once, here, so it cannot fight what the user types afterwards.
            var suggested = new URLSearchParams(window.location.search).get('amount');
            this.amount = ko.observable(
                suggested && !isNaN(parseFloat(suggested))
                    ? parseFloat(suggested).toFixed(2)
                    : "<%= Number(budget.Amount).toFixed(2) %>");
            this.uniqueId = ko.observable("<%= budget.UniqueId %>");
            this.saving = ko.observable(false);

            var uniqueId = this.uniqueId();

            this.newBudget = function () {
                if (self.amount() === '' || isNaN(parseFloat(self.amount()))) {
                    alert(t('js.enterWeeklyAmount'));
                    return;
                }

                self.saving(true);
                api.send("POST", "/api/Budget", {
                    name: self.name() || 'My',
                    startDayOfWeek: self.startDay(),
                    amount: parseFloat(self.amount()),
                    uniqueId: uniqueId
                })
                    .then(function () { window.location.href = '/Budget/' + uniqueId; })
                    .catch(function () {
                        self.saving(false);
                        alert(t('js.budgetCreateFailed'));
                    });
            };
        }

        ko.applyBindings(new NewBudgetViewModel());
    </script>
<%- include('partials/foot') %>
