<%- include('partials/head') %>
            <div class="appbar__titles">
                <h1 class="appbar__title"><a href="/Budget/<%= budget.UniqueId %>">Edit budget</a></h1>
                <span class="appbar__sub"><%= budget.Name || "Weekly Budget" %></span>
            </div>
            <div class="appbar__actions"><a class="btn btn--text" href="/Budget/<%= budget.UniqueId %>">Cancel</a></div>
<%- include('partials/afterbar') %>
<div class="field mt-l">
    <label class="field__label" for="name">Budget name</label>
    <input class="field__input" id="name" type="text" data-bind="value: name" placeholder="Household" />
</div>

<div class="field">
    <label class="field__label" for="amount">Weekly amount</label>
    <input class="field__input" id="amount" type="number" inputmode="decimal" step="0.01"
           data-bind="value: amount" placeholder="0.00" />
</div>

<div class="field">
    <label class="field__label" for="startDay">Week starts on</label>
    <select class="field__input" id="startDay" data-bind="options: dates, value: startDay"></select>
</div>

<section class="card">
    <div class="id-card">
        <div>
            <div class="field__label" style="margin-bottom:4px">Budget ID</div>
            <div class="id-card__value" data-bind="text: uniqueId"></div>
            <p class="field__hint" style="margin-left:0">
                Share this ID to open the same budget on another device, or in the
                iPhone or Android app.
            </p>
            <p style="margin:12px 0 0">
                <a href="/Budget/<%= budget.UniqueId %>/HowItWorks">How this works</a>
                &middot;
                <a href="/Budget/<%= budget.UniqueId %>/Apps">Get the app</a>
                &middot;
                <a href="/Budget/<%= budget.UniqueId %>/About">About</a>
            </p>
        </div>
    </div>
</section>

<%#
    The better way to hand a budget to someone: a link that expires and works
    once, rather than the id itself, which never expires and cannot be taken
    back. The ID above stays because older app versions in the field only know
    how to join that way.
%>
<section class="card mt-l">
    <div class="field__label">Invite someone</div>
    <p class="field__hint" style="margin-left:0">
        A one-time link, good for seven days. Better than sending the ID: it stops
        working once it has been used, and you can cancel it.
    </p>
    <div class="form-actions">
        <button class="btn btn--block btn--outlined" id="invite-create">Create an invite link</button>
    </div>
    <div id="invite-result" hidden>
        <div class="id-card__value" id="invite-url" style="word-break:break-all"></div>
        <div class="form-actions stack">
            <button class="btn btn--block" id="invite-share">Share link</button>
            <button class="btn btn--block btn--outlined" id="invite-copy">Copy link</button>
            <button class="btn btn--block btn--danger" id="invite-revoke">Cancel this invite</button>
        </div>
    </div>
</section>

<div class="form-actions">
    <button class="btn btn--block" data-bind="click: save, disable: saving">Save budget</button>
</div>
<%- include('partials/bottomnav', { budget: budget }) %>
<%- include('partials/scripts') %>
<script type="text/javascript">
        function EditBudgetViewModel() {
            var self = this;
            var uniqueId = "<%= budget.UniqueId %>";

            this.name = ko.observable(<%- JSON.stringify(budget.Name || "") %>);
            this.startDay = ko.observable("<%= budget.StartDayOfWeek %>");
            this.dates = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            this.amount = ko.observable("<%= Number(budget.Amount).toFixed(2) %>");
            this.uniqueId = ko.observable(uniqueId);
            this.saving = ko.observable(false);

            this.save = function () {
                if (self.amount() === '' || isNaN(parseFloat(self.amount()))) {
                    alert('Enter a weekly amount');
                    return;
                }

                self.saving(true);
                api.send("PUT", "/api/Budget/" + uniqueId, {
                    name: self.name() || 'My',
                    startDayOfWeek: self.startDay(),
                    amount: parseFloat(self.amount()),
                    uniqueId: uniqueId
                })
                    .then(function () { window.location.href = '/Budget/' + uniqueId; })
                    .catch(function () {
                        self.saving(false);
                        alert('Could not save that budget. Please try again.');
                    });
            };
        }

        ko.applyBindings(new EditBudgetViewModel());

        // Plain DOM rather than a Knockout section: this is three buttons and one
        // string, and it does not belong in the view model that saves the budget.
        (function () {
            var budgetId = "<%= budget.UniqueId %>";
            var create = document.getElementById('invite-create');
            var result = document.getElementById('invite-result');
            var urlBox = document.getElementById('invite-url');
            var shareBtn = document.getElementById('invite-share');
            var copyBtn = document.getElementById('invite-copy');
            var revokeBtn = document.getElementById('invite-revoke');
            var token = null;

            // navigator.share is the right control on a phone and does not exist
            // on most desktops, so it is only offered where it works.
            if (!navigator.share) { shareBtn.hidden = true; }

            create.addEventListener('click', function () {
                create.disabled = true;
                api.send('POST', '/api/Budget/' + budgetId + '/invites', {})
                    .then(function (invite) {
                        token = invite.Token;
                        urlBox.textContent = invite.Url;
                        result.hidden = false;
                        create.textContent = 'Create another link';
                        create.disabled = false;
                    })
                    .catch(function () {
                        create.disabled = false;
                        alert('Could not create an invite link. Please try again.');
                    });
            });

            shareBtn.addEventListener('click', function () {
                navigator.share({
                    title: 'Join my weekly budget',
                    text: 'Tap to share my weekly budget:',
                    url: urlBox.textContent
                }).catch(function () { /* the user dismissed the sheet */ });
            });

            copyBtn.addEventListener('click', function () {
                var done = function () {
                    copyBtn.textContent = 'Copied';
                    setTimeout(function () { copyBtn.textContent = 'Copy link'; }, 2000);
                };
                // clipboard.writeText needs a secure context, which a plain-HTTP
                // visit is not, so there has to be something to fall back to.
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(urlBox.textContent).then(done, select);
                } else {
                    select();
                }
                function select() {
                    var range = document.createRange();
                    range.selectNodeContents(urlBox);
                    var selection = window.getSelection();
                    selection.removeAllRanges();
                    selection.addRange(range);
                }
            });

            revokeBtn.addEventListener('click', function () {
                if (!token) { return; }
                api.send('DELETE', '/api/invites/' + token)
                    .then(function () {
                        result.hidden = true;
                        token = null;
                        create.textContent = 'Create an invite link';
                    })
                    .catch(function () { alert('Could not cancel that invite.'); });
            });
        })();
    </script>
<%- include('partials/foot') %>
