<%- include('partials/head') %>
            <div class="appbar__titles">
                <h1 class="appbar__title"><a href="/Budget/<%= budget.UniqueId %>"><%= t('editBudget.title') %></a></h1>
                <span class="appbar__sub"><%= budget.Name || "Weekly Budget" %></span>
            </div>
            <div class="appbar__actions"><a class="btn btn--text" href="/Budget/<%= budget.UniqueId %>"><%= t('action.cancel') %></a></div>
<%- include('partials/afterbar') %>
<div class="field mt-l">
    <label class="field__label" for="name"><%= t('budget.name') %></label>
    <input class="field__input" id="name" type="text" data-bind="value: name" placeholder="<%= t('budget.name.example') %>" />
</div>

<div class="field">
    <label class="field__label" for="amount"><%= t('budget.amount') %></label>
    <input class="field__input" id="amount" type="number" inputmode="decimal" step="0.01"
           data-bind="value: amount" placeholder="0.00" />
    <%# Directly under the field, because "how much a week?" is the question
       this page asks that people cannot answer. %>
    <p class="field__hint" style="margin-top:6px"><a href="/Budget/<%= budget.UniqueId %>/WeeklyNumber"><%= t('planner.open') %></a></p>
</div>

<div class="field">
    <label class="field__label" for="startDay"><%= t('budget.startDay') %></label>
    <select class="field__input" id="startDay" data-bind="options: dates, value: startDay"></select>
</div>

<section class="card">
    <div class="id-card">
        <div>
            <div class="field__label" style="margin-bottom:4px"><%= t('budget.id') %></div>
            <div class="id-card__value" data-bind="text: uniqueId"></div>
            <p class="field__hint" style="margin-left:0">
                <%= t('budget.id.hint') %>
            </p>
            <p style="margin:12px 0 0">
                <a href="/Budget/<%= budget.UniqueId %>/HowItWorks"><%= t('howItWorks.title') %></a>
                &middot;
                <a href="/Budget/<%= budget.UniqueId %>/Apps"><%= t('join.getApp') %></a>
                &middot;
                <a href="/Budget/<%= budget.UniqueId %>/About"><%= t('about.title') %></a>
            </p>
        </div>
    </div>
</section>

<%#
    The better way to hand a budget to someone: a link that expires and works
    once, rather than the id itself, which never expires and cannot be taken
    back. The ID above stays because older app versions in the field only know
    how to join that way.
%>
<section class="card mt-l">
    <div class="field__label"><%= t('invite.heading') %></div>
    <p class="field__hint" style="margin-left:0">
        <%= t('invite.hint') %>
    </p>
    <div class="form-actions">
        <button class="btn btn--block btn--outlined" id="invite-create"><%= t('invite.create') %></button>
    </div>
    <div id="invite-result" hidden>
        <div class="id-card__value" id="invite-url" style="word-break:break-all"></div>
        <div class="form-actions stack">
            <button class="btn btn--block" id="invite-share"><%= t('invite.share') %></button>
            <button class="btn btn--block btn--outlined" id="invite-copy"><%= t('invite.copy') %></button>
            <button class="btn btn--block btn--danger" id="invite-revoke"><%= t('invite.revoke') %></button>
        </div>
    </div>
</section>

<div class="form-actions">
    <button class="btn btn--block" data-bind="click: save, disable: saving"><%= t('budget.save') %></button>
</div>
<%- include('partials/bottomnav', { budget: budget }) %>
<%- include('partials/scripts') %>
<script type="text/javascript">
        function EditBudgetViewModel() {
            var self = this;
            var uniqueId = "<%= budget.UniqueId %>";

            this.name = ko.observable(<%- JSON.stringify(budget.Name || "") %>);
            this.startDay = ko.observable("<%= budget.StartDayOfWeek %>");
            this.dates = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            // A figure accepted in the helper comes back as ?amount=. Read
            // once, here, so it cannot fight what the user types afterwards.
            var suggested = new URLSearchParams(window.location.search).get('amount');
            this.amount = ko.observable(
                suggested && !isNaN(parseFloat(suggested))
                    ? parseFloat(suggested).toFixed(2)
                    : "<%= Number(budget.Amount).toFixed(2) %>");
            this.uniqueId = ko.observable(uniqueId);
            this.saving = ko.observable(false);

            this.save = function () {
                if (self.amount() === '' || isNaN(parseFloat(self.amount()))) {
                    alert(t('js.enterWeeklyAmount'));
                    return;
                }

                self.saving(true);
                api.send("PUT", "/api/Budget/" + uniqueId, {
                    name: self.name() || 'My',
                    startDayOfWeek: self.startDay(),
                    amount: parseFloat(self.amount()),
                    uniqueId: uniqueId
                })
                    .then(function () { window.location.href = '/Budget/' + uniqueId; })
                    .catch(function () {
                        self.saving(false);
                        alert(t('js.budgetSaveFailed'));
                    });
            };
        }

        ko.applyBindings(new EditBudgetViewModel());

        // Plain DOM rather than a Knockout section: this is three buttons and one
        // string, and it does not belong in the view model that saves the budget.
        (function () {
            var budgetId = "<%= budget.UniqueId %>";
            var create = document.getElementById('invite-create');
            var result = document.getElementById('invite-result');
            var urlBox = document.getElementById('invite-url');
            var shareBtn = document.getElementById('invite-share');
            var copyBtn = document.getElementById('invite-copy');
            var revokeBtn = document.getElementById('invite-revoke');
            var token = null;

            // navigator.share is the right control on a phone and does not exist
            // on most desktops, so it is only offered where it works.
            if (!navigator.share) { shareBtn.hidden = true; }

            create.addEventListener('click', function () {
                create.disabled = true;
                api.send('POST', '/api/Budget/' + budgetId + '/invites', {})
                    .then(function (invite) {
                        token = invite.Token;
                        urlBox.textContent = invite.Url;
                        result.hidden = false;
                        create.textContent = t('js.inviteCreateAnother');
                        create.disabled = false;
                    })
                    .catch(function () {
                        create.disabled = false;
                        alert(t('js.inviteCreateFailed'));
                    });
            });

            shareBtn.addEventListener('click', function () {
                navigator.share({
                    title: t('js.inviteShareTitle'),
                    text: t('js.inviteShareText'),
                    url: urlBox.textContent
                }).catch(function () { /* the user dismissed the sheet */ });
            });

            copyBtn.addEventListener('click', function () {
                var done = function () {
                    copyBtn.textContent = t('js.copied');
                    setTimeout(function () { copyBtn.textContent = t('js.inviteCopy'); }, 2000);
                };
                // clipboard.writeText needs a secure context, which a plain-HTTP
                // visit is not, so there has to be something to fall back to.
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(urlBox.textContent).then(done, select);
                } else {
                    select();
                }
                function select() {
                    var range = document.createRange();
                    range.selectNodeContents(urlBox);
                    var selection = window.getSelection();
                    selection.removeAllRanges();
                    selection.addRange(range);
                }
            });

            revokeBtn.addEventListener('click', function () {
                if (!token) { return; }
                api.send('DELETE', '/api/invites/' + token)
                    .then(function () {
                        result.hidden = true;
                        token = null;
                        create.textContent = t('js.inviteCreate');
                    })
                    .catch(function () { alert(t('js.inviteCancelFailed')); });
            });
        })();
    </script>
<%- include('partials/foot') %>
