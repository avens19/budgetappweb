<%#
    The bottom bar, which was duplicated verbatim in five views before this.
    Callers pass `budget`, and `active` when the page is a tab:
    week | month | categories | add. The edit pages belong to no tab and omit it,
    so this reads locals.active — a bare `active` would be a ReferenceError.
%>
    </main>
    <nav class="bottomnav">
        <div class="bottomnav__inner">
            <a class="bottomnav__item" href="/Budget/<%= budget.UniqueId %>"
               <%= locals.active === 'week' ? 'aria-current="page"' : '' %>>
                <span class="bottomnav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14v11z"/></svg></span>
                <%= t('nav.week') %>
            </a>
            <a class="bottomnav__item" href="/Budget/<%= budget.UniqueId %>/Month"
               <%= locals.active === 'month' ? 'aria-current="page"' : '' %>>
                <span class="bottomnav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 3h-1V1h-2v2H7V1H5v2H4a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 18H4V8h16v13zM6 10h5v5H6z"/></svg></span>
                <%= t('nav.month') %>
            </a>
            <a class="bottomnav__item" href="/Budget/<%= budget.UniqueId %>/Categories"
               <%= locals.active === 'categories' ? 'aria-current="page"' : '' %>>
                <span class="bottomnav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 2v20c-5.07-.5-9-4.79-9-10s3.93-9.5 9-10zm2.03 0v8.99H22c-.47-4.74-4.24-8.52-8.97-8.99zm0 11.01V22c4.74-.47 8.5-4.25 8.97-8.99h-8.97z"/></svg></span>
                <%= t('nav.categories') %>
            </a>
            <a class="bottomnav__item bottomnav__item--accent" href="/Budget/<%= budget.UniqueId %>/Add"
               <%= locals.active === 'add' ? 'aria-current="page"' : '' %>>
                <span class="bottomnav__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"/></svg></span>
                <%= t('nav.add') %>
            </a>
        </div>
    </nav>
