<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#f6fbf5" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0f1511" media="(prefers-color-scheme: dark)">
    <%# Both spellings on purpose: iOS still reads the apple- one, and Chrome
       warns that it is deprecated in favour of the standard name. %>
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Weekly Budget">
    <title><%= title %> - Weekly Budget</title>
    <link href="/app.css" rel="stylesheet" type="text/css" />
    <%# The icon matters more here than on most sites: the app tells iPhone
       users to add this page to the home screen, and without an
       apple-touch-icon iOS uses a screenshot of the page instead. These are
       generated from the same artwork as the Android launcher and the iOS app
       icon, so all three look like one product. %>
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/icon-180.png">
    <link rel="manifest" href="/site.webmanifest">
</head>
<body>
    <header class="appbar" id="appbar">
        <div class="appbar__inner">
