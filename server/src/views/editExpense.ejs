<%- include('partials/head') %>
            <div class="appbar__titles">
                <h1 class="appbar__title"><a href="/Budget/<%= budget.UniqueId %>">Edit expense</a></h1>
                <span class="appbar__sub"><%= budget.Name || "Weekly Budget" %></span>
            </div>
            <div class="appbar__actions"><a class="btn btn--text" href="/Budget/<%= budget.UniqueId %>">Cancel</a></div>
<%- include('partials/afterbar') %>
<section class="card amount-card">
    <label class="field__label" for="amount">Amount</label>
    <input class="field__input" id="amount" type="number" autofocus inputmode="decimal" step="0.01"
           placeholder="0" data-bind="value: amount, valueUpdate: 'input'" />
</section>

<div class="field mt-l">
    <label class="field__label" for="description">Description</label>
    <input class="field__input" id="description" type="text" data-bind="value: description" />
</div>

<div class="field">
    <label class="field__label" for="date">Date</label>
    <input class="field__input" id="date" type="date" data-bind="value: date" />
</div>

<div class="field">
    <label class="field__label" for="category">Category</label>
    <select class="field__input" id="category"
            data-bind="options: categoryOptions, optionsText: 'name', optionsValue: 'id',
                       value: categoryChoice"></select>
</div>

<div class="field" data-bind="visible: isNewCategory">
    <label class="field__label" for="newCategory">New category name</label>
    <input class="field__input" id="newCategory" type="text" data-bind="value: newCategoryName" />
</div>

<div class="form-actions stack">
    <button class="btn btn--block" data-bind="click: save, disable: saving">Save changes</button>
    <%# Both of these existed only on the phone. Without the first there was no
       way at all to remove an expense from the web. %>
    <button class="btn btn--block btn--outlined" data-bind="click: copyToNextWeek, disable: saving">
        Copy to next week
    </button>
    <button class="btn btn--block btn--danger" data-bind="click: remove, disable: saving">
        Delete expense
    </button>
</div>
<%- include('partials/bottomnav', { budget: budget }) %>
<%- include('partials/scripts') %>
<script type="text/javascript">
        function EditExpenseViewModel() {
            var self = this;
            var budgetId = "<%= budget.UniqueId %>";

            this.date = ko.observable("<%= expense.Date.slice(0, 10) %>");
            this.description = ko.observable(<%- JSON.stringify(expense.Description) %>);
            this.amount = ko.observable(<%= expense.Amount %>);
            this.saving = ko.observable(false);

            var NONE = '', NEW = 'new';
            var current = <%- expense.CategoryId == null ? "''" : JSON.stringify(String(expense.CategoryId)) %>;
            this.categoryOptions = ko.observableArray([{ id: NONE, name: 'No category' }]);
            this.categoryChoice = ko.observable(current);
            this.newCategoryName = ko.observable('');
            this.isNewCategory = ko.computed(function () { return self.categoryChoice() === NEW; });

            loadCategories(budgetId, function (rows) {
                var options = [{ id: NONE, name: 'No category' }];
                rows.sort(function (a, b) { return a.Name.localeCompare(b.Name); });
                for (var i = 0; i < rows.length; i++) {
                    options.push({ id: String(rows[i].Id), name: rows[i].Name });
                }
                options.push({ id: NEW, name: 'New category…' });
                self.categoryOptions(options);
                // Re-assert the selection: the options only exist now, and
                // Knockout drops a value that was not among them.
                self.categoryChoice(current);
            });

            function resolveCategory(done, fail) {
                if (self.categoryChoice() !== NEW) {
                    done(self.categoryChoice() === NONE ? null : parseInt(self.categoryChoice(), 10));
                    return;
                }
                var name = (self.newCategoryName() || '').trim();
                if (!name) { fail('Name the new category, or pick No category.'); return; }

                api.send('POST', '/api/Categories', { name: name, budgetId: budgetId })
                    .then(function (created) { done(created.Id); })
                    .catch(function () { fail('Could not create that category. Please try again.'); });
            }

            this.save = function () {
                if (!self.description()) { alert('Enter a description'); return; }
                if (self.amount() === '' || isNaN(parseFloat(self.amount()))) {
                    alert('Enter an amount');
                    return;
                }

                self.saving(true);
                resolveCategory(function (categoryId) {
                    api.send("PUT", "/api/Expense/<%= expense.Id %>", {
                        id: <%= expense.Id %>,
                        date: self.date(),
                        description: self.description(),
                        amount: parseFloat(self.amount()),
                        budgetId: budgetId,
                        categoryId: categoryId
                    })
                        .then(function () { window.location.href = '/Budget/' + budgetId; })
                        .catch(function () {
                            self.saving(false);
                            alert('Could not save that change. Please try again.');
                        });
                }, function (message) {
                    self.saving(false);
                    alert(message);
                });
            };

            // Same expense, seven days on — the phone's "Copy to next week",
            // for the shop you visit every week for the same amount.
            this.copyToNextWeek = function () {
                var parts = self.date().split('-');
                var moved = new Date(+parts[0], +parts[1] - 1, +parts[2]).addDays(7);

                self.saving(true);
                resolveCategory(function (categoryId) {
                    api.send('POST', '/api/Expense', {
                        date: toDateInput(moved),
                        description: self.description(),
                        amount: parseFloat(self.amount()),
                        budgetId: budgetId,
                        categoryId: categoryId
                    })
                        .then(function () { window.location.href = '/Budget/' + budgetId; })
                        .catch(function () {
                            self.saving(false);
                            alert('Could not copy that expense. Please try again.');
                        });
                }, function (message) {
                    self.saving(false);
                    alert(message);
                });
            };

            this.remove = function () {
                if (!confirm('Delete "' + self.description() + '"?')) { return; }
                self.saving(true);
                api.send('DELETE', '/api/Expense/<%= expense.Id %>')
                    .then(function () { window.location.href = '/Budget/' + budgetId; })
                    .catch(function () {
                        self.saving(false);
                        alert('Could not delete that expense. Please try again.');
                    });
            };
        }

        ko.applyBindings(new EditExpenseViewModel());
    </script>
<%- include('partials/foot') %>
