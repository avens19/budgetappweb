<%- include('partials/head') %>
            <div class="appbar__titles">
                <h1 class="appbar__title"><a href="/Budget/<%= budget.UniqueId %>"><%= t('addExpense.title') %></a></h1>
                <span class="appbar__sub"><%= budget.Name || "Weekly Budget" %></span>
            </div>
            <div class="appbar__actions"><a class="btn btn--text" href="/Budget/<%= budget.UniqueId %>"><%= t('action.cancel') %></a></div>
<%- include('partials/afterbar') %>
<%#
    Amount first and large, as on the phone: it is the one field that always
    has to be typed.
%>
<section class="card amount-card">
    <label class="field__label" for="amount"><%= t('expense.amount') %></label>
    <input class="field__input" id="amount" type="number" autofocus inputmode="decimal" step="0.01"
           placeholder="0" data-bind="value: amount, valueUpdate: 'input'" />
</section>

<div class="field mt-l">
    <label class="field__label" for="description"><%= t('expense.description') %></label>
    <input class="field__input" id="description" type="text" data-bind="value: description" />
</div>

<div class="field">
    <label class="field__label" for="date"><%= t('expense.date') %></label>
    <input class="field__input" id="date" type="date" data-bind="value: date" />
</div>

<%# Categories are created from here rather than on a screen of their own,
   which is how the app does it too — you name one at the moment you first
   need it. %>
<div class="field">
    <label class="field__label" for="category"><%= t('expense.category') %></label>
    <select class="field__input" id="category"
            data-bind="options: categoryOptions, optionsText: 'name', optionsValue: 'id',
                       value: categoryChoice"></select>
</div>

<div class="field" data-bind="visible: isNewCategory">
    <label class="field__label" for="newCategory"><%= t('expense.newCategory') %></label>
    <input class="field__input" id="newCategory" type="text" data-bind="value: newCategoryName" />
</div>

<p class="field__hint"><%= t('expense.incomeHint') %></p>

<div class="form-actions">
    <button class="btn btn--block" data-bind="click: addExpense, disable: saving"><%= t('addExpense.action') %></button>
</div>
<%- include('partials/bottomnav', { budget: budget, active: 'add' }) %>
<%- include('partials/scripts') %>
<script type="text/javascript">
        function AddExpenseViewModel() {
            var self = this;
            var budgetId = "<%= budget.UniqueId %>";

            // A native date input, so phones get the platform picker and the
            // value is already the yyyy-MM-dd the API parses.
            this.date = ko.observable(toDateInput(new Date()));
            this.description = ko.observable('');
            this.amount = ko.observable('');
            this.saving = ko.observable(false);

            var NONE = '', NEW = 'new';
            this.categoryOptions = ko.observableArray([{ id: NONE, name: t('js.noCategory') }]);
            this.categoryChoice = ko.observable(NONE);
            this.newCategoryName = ko.observable('');
            this.isNewCategory = ko.computed(function () { return self.categoryChoice() === NEW; });

            loadCategories(budgetId, function (rows) {
                var options = [{ id: NONE, name: t('js.noCategory') }];
                rows.sort(function (a, b) { return a.Name.localeCompare(b.Name); });
                for (var i = 0; i < rows.length; i++) {
                    options.push({ id: String(rows[i].Id), name: rows[i].Name });
                }
                options.push({ id: NEW, name: t('js.newCategory') });
                self.categoryOptions(options);
            });

            // Resolves the picker to an id the expense can carry, creating the
            // category first when the user typed a new name.
            function resolveCategory(done, fail) {
                if (self.categoryChoice() !== NEW) {
                    done(self.categoryChoice() === NONE ? null : parseInt(self.categoryChoice(), 10));
                    return;
                }
                var name = (self.newCategoryName() || '').trim();
                if (!name) { fail('Name the new category, or pick No category.'); return; }

                api.send('POST', '/api/Categories', { name: name, budgetId: budgetId })
                    .then(function (created) { done(created.Id); })
                    .catch(function () { fail('Could not create that category. Please try again.'); });
            }

            this.addExpense = function () {
                if (!self.description()) { alert(t('js.enterDescription')); return; }
                if (self.amount() === '' || isNaN(parseFloat(self.amount()))) {
                    alert(t('js.enterAmount'));
                    return;
                }

                self.saving(true);
                resolveCategory(function (categoryId) {
                    api.send("POST", "/api/Expense", {
                        date: self.date(),
                        description: self.description(),
                        amount: parseFloat(self.amount()),
                        budgetId: budgetId,
                        categoryId: categoryId
                    })
                        .then(function () { window.location.href = '/Budget/' + budgetId; })
                        .catch(function () {
                            self.saving(false);
                            alert(t('js.expenseSaveFailed'));
                        });
                }, function (message) {
                    self.saving(false);
                    alert(message);
                });
            };
        }

        ko.applyBindings(new AddExpenseViewModel());
    </script>
<%- include('partials/foot') %>
