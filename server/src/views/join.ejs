<%#
    Where an invite link lands.

    The only thing on this page that spends the invite is the form below, and it
    is a POST. Nothing about that is incidental: every messaging client fetches a
    shared URL to build a preview, and a GET that redeemed would leave the invite
    dead before its recipient ever tapped it.

    The budget id is deliberately absent from this page until the form has been
    submitted. It is the durable credential — printing it here would hand it to
    every preview bot and proxy the link travelled through, which is the entire
    problem invites exist to solve.
%>
<%- include('partials/head', { noindex: true }) %>
            <div class="appbar__titles">
                <h1 class="appbar__title"><%= t('join.title') %></h1>
            </div>
<%- include('partials/afterbar') %>
<article class="prose">
<% if (state === 'ok') { %>
    <span class="prose__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg></span>
    <h2><%= t('join.invited.title') %></h2>
    <p><%- t('join.invited.body', { name: budgetName || t('join.theirBudget') }) %></p>

    <form method="post" action="/join/<%= token %>">
        <div class="form-actions">
            <button class="btn btn--block" type="submit"><%= t('join.action') %></button>
        </div>
    </form>

    <p class="field__hint" style="margin:12px 0 0">
        <%= t('join.once') %>
    </p>
<% } else { %>
    <span class="prose__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm-1-5h2v2h-2zm0-8h2v6h-2z"/></svg></span>
    <h2><%= t('join.unusable.title') %></h2>
    <%#
        Used, expired and revoked are one message on purpose. They all lead to
        the same next step, and telling them apart would make the page a report
        on which tokens exist.
    %>
    <p><%= t('join.unusable.body') %></p>
    <p><%= t('join.unusable.reassure') %></p>
<% } %>

    <p style="margin-top:24px">
        <a href="/Apps"><%= t('join.getApp') %></a> &middot; <a href="/HowItWorks"><%= t('howItWorks.title') %></a>
    </p>
</article>
<%- include('partials/beforenav') %>
<%- include('partials/scripts') %>
<%- include('partials/foot') %>
