{
  "name": "budgetapp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Weekly Budget server. Replaces the ASP.NET app; speaks the same wire protocol, documented in ../CONTRACT.md.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch --preserveWatchOutput & node --watch dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
